<Window x:Class="YtDlpGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="yt-dlp-gui" Width="900" Height="650" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="Abrir pasta de binários" Click="OpenBinFolder_Click"/>
                <MenuItem Header="Abrir pasta de logs" Click="OpenLogFolder_Click"/>
                <Separator/>
                <MenuItem Header="Sair" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="Limpar lista de URLs" Click="ClearUrls_Click"/>
            </MenuItem>
            <MenuItem Header="_Ajuda">
                <MenuItem Header="Sobre" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Pronto"/>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Parâmetros" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="URL(s) do vídeo" VerticalAlignment="Top" Margin="0,5,12,0"/>
                    <TextBox x:Name="UrlsTextBox" Grid.Column="1" Grid.ColumnSpan="3" Height="72"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="Cole uma URL por linha. Apenas endereços http:// e https:// são aceitos."/>
                    <TextBlock Grid.Row="1" Text="Salvar em" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <TextBox x:Name="PathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,10,4,0"
                             IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Click="BrowsePath_Click" Margin="4,10,4,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="Procurar"/></StackPanel>
                    </Button>
                    <ComboBox x:Name="PresetComboBox" Grid.Row="1" Grid.Column="3" Width="145"
                              Margin="4,10,0,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Modelo" VerticalAlignment="Center" Margin="0,12,12,0"
                               ToolTip="Modelos baseados nos exemplos do yt-dlp."/>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelComboBox" DisplayMemberPath="Name"
                                  SelectionChanged="ModelComboBox_SelectionChanged"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Selecione um modelo para aplicar argumentos prontos do yt-dlp."/>
                        <TextBlock x:Name="ModelHintTextBlock" Grid.Column="1" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="#64748B" FontSize="11"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <Expander Grid.Row="1" Header="&#xE713;  Configurações avançadas" FontFamily="Segoe UI" IsExpanded="False"
                      Margin="0,0,0,10" Padding="0,4">
                <Border BorderBrush="#D9E2F3" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="IgnoreErrorsCheckBox" Content="Ignorar erros" ToolTip="Continua a fila mesmo quando um item falha."/>
                        <CheckBox x:Name="AbortOnErrorCheckBox" Grid.Column="1" Content="Parar no primeiro erro"
                                  ToolTip="Interrompe a fila quando o yt-dlp retorna erro."/>
                        <CheckBox x:Name="FlatPlaylistCheckBox" Grid.Row="1" Content="Lista plana"
                                  ToolTip="Mais rápido, mas pode omitir metadados de itens da playlist."/>
                        <CheckBox x:Name="LiveFromStartCheckBox" Grid.Row="1" Grid.Column="1" Content="Live desde o início"/>
                        <CheckBox x:Name="MarkWatchedCheckBox" Grid.Row="2" Content="Marcar como assistido"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Aguardar vídeo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="WaitForVideoTextBox" Width="90" ToolTip="Segundos ou intervalo, por exemplo 30-60."/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,6,0">
                            <TextBlock Text="Runtime JS:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="JsRuntimeTextBox" Width="150" ToolTip="deno, node, quickjs ou bun."/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Componentes remotos:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RemoteComponentsTextBox" Width="150" ToolTip="Separe por vírgulas: ejs:npm, ejs:github."/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,6,0">
                            <TextBlock Text="Arquivo de configuração:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="ConfigLocationTextBox" Width="150"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Pasta de plugins:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="PluginDirectoryTextBox" Width="150"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="As opções são aplicadas a todos os itens adicionados ao iniciar o download."
                                   Foreground="#64748B" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Expander>

            <GroupBox Grid.Row="2" Header="Downloads" Padding="6">
                <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding Downloads}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="Preset" Binding="{Binding Preset}" Width="90"/>
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="90"/>
                        <DataGridTextColumn Header="Progresso" Binding="{Binding Progress}" Width="95"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Velocidade" Binding="{Binding Speed}" Width="100"/>
                        <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Click="ClearDownloads_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="Limpar"/></StackPanel></Button>
                <Button Click="Add_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="Adicionar"/></StackPanel></Button>
                <Button IsDefault="True" Background="{StaticResource AccentBrush}"
                        Foreground="White" Click="Download_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="Baixar"/></StackPanel></Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
